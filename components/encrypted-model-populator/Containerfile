FROM docker.io/library/golang@sha256:22bd1c41c958c762e9633f07a5fee8266300e5f25e18e269a6d87a4b870368aa AS build
WORKDIR /src
COPY . .
RUN go mod download && go mod verify
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /encrypted-model-populator .
FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /encrypted-model-populator /encrypted-model-populator
USER 1001
ENTRYPOINT ["/encrypted-model-populator"]
